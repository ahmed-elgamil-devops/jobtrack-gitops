{"title":"JobTrack","uid":"jobtrack","schemaVersion":39,"version":1,"refresh":"30s","time":{"from":"now-1h","to":"now"},"tags":["jobtrack","fastapi"],"templating":{"list":[{"name":"datasource","type":"datasource","query":"prometheus","label":"Data source"}]},"panels":[{"id":1,"type":"stat","title":"Requests / sec","gridPos":{"x":0,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"${datasource}"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(http_requests_total{job=~\".*jobtrack-api\"}[5m]))"}]},{"id":2,"type":"stat","title":"Error rate (5xx)","gridPos":{"x":6,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"${datasource}"},"fieldConfig":{"defaults":{"unit":"percentunit"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(http_requests_total{job=~\".*jobtrack-api\",status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\".*jobtrack-api\"}[5m])),1e-9)"}]},{"id":3,"type":"stat","title":"p95 latency","gridPos":{"x":12,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"${datasource}"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\".*jobtrack-api\"}[5m])) by (le))"}]},{"id":4,"type":"stat","title":"API pods up","gridPos":{"x":18,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"${datasource}"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(up{job=~\".*jobtrack-api\"})"}]},{"id":5,"type":"timeseries","title":"Requests by endpoint","gridPos":{"x":0,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${datasource}"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(http_requests_total{job=~\".*jobtrack-api\"}[5m])) by (handler)","legendFormat":"{{handler}}"}]},{"id":6,"type":"timeseries","title":"Latency p50 / p95 / p99","gridPos":{"x":12,"y":